# ============================================================
# MULTILINGUAL BIBLE APP — POSTGRESQL CONFIGURATION
# ============================================================
# The app supports any standard PostgreSQL database.
# When no DATABASE_URL is set, the app runs in autonomous fallback mode
# using high-speed bundled & disk datasets across all 66 books.

# --- Option 1: Standard / Local PostgreSQL ---
DATABASE_URL="postgres://postgres:postgres@localhost:5432/ruth_bible"

# --- Option 2: Vercel Postgres / Neon ---
# Automatically populated by Vercel when adding Vercel Postgres storage
# POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"
# POSTGRES_PRISMA_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require&pgbouncer=true"

# --- Option 3: Supabase ---
# SUPABASE_DB_URL="postgres://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# --- Option 4: Railway / Render / AWS RDS / Cloud SQL ---
# DATABASE_URL="postgres://username:password@hostname:5432/database_name?sslmode=require"

# --- Web Push Notifications (Optional) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:support@yourdomain.com"
